#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Lukas Koerber
# SPDX-License-Identifier: MIT
#
# Runs a development Home Assistant on port 8123 with custom_components/gitlab_monitor loaded
# from this checkout. The instance config lives in config/ (git-ignored). On the first start Home
# Assistant installs missing runtime requirements into config/deps; that is expected.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ ! -d config ]; then
  mkdir -p config
fi

if [ ! -f config/configuration.yaml ]; then
  cat > config/configuration.yaml <<'YAML'
default_config:

logger:
  default: info
  logs:
    custom_components.gitlab_monitor: debug
YAML
fi

# GitHub Codespaces forwards port 8123 through a reverse proxy on localhost that sets
# X-Forwarded-For. Home Assistant answers "400 Bad Request" unless the http integration trusts it.
if ! grep -q '^http:' config/configuration.yaml; then
  cat >> config/configuration.yaml <<'YAML'

# Trust the Codespaces port forwarder (a reverse proxy on localhost).
http:
  use_x_forwarded_for: true
  trusted_proxies:
    - 127.0.0.1
    - ::1
YAML
elif ! grep -q 'use_x_forwarded_for' config/configuration.yaml; then
  echo "scripts/develop: config/configuration.yaml has its own http: section; add use_x_forwarded_for: true and trusted_proxies 127.0.0.1 and ::1 to it, or the Codespaces port forwarding answers 400." >&2
fi

# pip installs the console scripts (hass, ruff) into ~/.local/bin when site-packages is read-only.
export PATH="${HOME}/.local/bin:${PATH}"

# Make custom_components/gitlab_monitor from the checkout importable as a custom integration.
export PYTHONPATH="${PYTHONPATH:-}:${PWD}/custom_components"

exec hass --config "${PWD}/config" --debug